# Local DB url
DATABASE_URL=postgresql+psycopg://{username}:{password}@localhost:5432/{database_name}
# If using Docker
DATABASE_URL=postgresql+psycopg://{username}:{password}@postgres:5432/{database_name}


# ============================================
# JWT Authentication Configuration
# ============================================
SECRET_KEY=your-secret-key-here-change-this-in-production  # Generate with: openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# Email Verification Configuration
# ============================================
# URL of the frontend application
APP_URL=http://localhost:5173
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=your-email@example.com

# ============================================
# LinkedIn OAuth Configuration
# ============================================
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:5173/linkedin/callback
LINKEDIN_TOKEN_ENCRYPTION_KEY=  # Generate with: openssl rand -hex 32
