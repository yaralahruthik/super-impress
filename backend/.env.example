# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/super_impress

# Better Auth Configuration
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:3000

# Resend Configuration (for password reset emails)
RESEND_API_KEY=re_********************************
RESEND_FROM_EMAIL=SuperImpress <noreply@your-domain.com>

# LinkedIn OAuth Configuration
# Get these from https://www.linkedin.com/developers/
# Required products: "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn"
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Note: The redirect URI for LinkedIn should be: http://localhost:3000/api/auth/callback/linkedin
# Add this to your LinkedIn app's authorized redirect URLs

# Server Configuration
PORT=3000
FRONTEND_URL=http://localhost:5173
